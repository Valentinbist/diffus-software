# Copy to .env and fill in. Never commit .env.

# Overridden by docker-compose for the containerized app.
DATABASE_URL=postgresql+asyncpg://connector:connector@localhost:5432/connector

# Meta app (Business Login for Instagram): https://developers.facebook.com/apps
IG_APP_ID=
IG_APP_SECRET=
# Must be a public HTTPS URL registered in the Meta app settings.
IG_REDIRECT_URI=https://your.host/oauth/callback

# @BotFather token; bot must be a member of the target chats.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids, e.g. -1001234567890,-1009876543210
TELEGRAM_CHAT_IDS=

POLL_INTERVAL_MINUTES=5

# IANA time zone for the times shown in the UI.
DISPLAY_TIMEZONE=Europe/Berlin

# UI credentials (HTTP Basic — cleartext without TLS in front).
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-me

# kalender.digital share link token: the 20 hex characters at the end of the link.
# It is an editor-level capability (anyone holding it can edit the calendar), so treat it
# like a password. Leave empty to run without the calendar.
KALENDER_DIGITAL_TOKEN=
# How far the calendar sync reaches back and ahead, in whole months.
CALENDAR_PAST_MONTHS=3
CALENDAR_FUTURE_MONTHS=6
