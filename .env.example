# Copy to .env and fill in. Never commit .env.

# Overridden by docker-compose for the containerized app.
DATABASE_URL=postgresql+asyncpg://connector:connector@localhost:5432/connector

# Meta app (Business Login for Instagram): https://developers.facebook.com/apps
IG_APP_ID=
IG_APP_SECRET=
# Must be a public HTTPS URL registered in the Meta app settings.
IG_REDIRECT_URI=https://your.host/oauth/callback

# @BotFather token; bot must be a member of the target chats.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids, e.g. -1001234567890,-1009876543210
TELEGRAM_CHAT_IDS=

POLL_INTERVAL_MINUTES=5

# IANA time zone for the times shown in the UI.
DISPLAY_TIMEZONE=Europe/Berlin

# UI credentials (HTTP Basic — cleartext without TLS in front).
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-me

# kalender.digital share link token: the 20 hex characters at the end of the link.
# It is an editor-level capability (anyone holding it can edit the calendar), so treat it
# like a password. Leave empty to run without the calendar.
KALENDER_DIGITAL_TOKEN=
# How far the calendar sync reaches back and ahead, in whole months.
CALENDAR_PAST_MONTHS=3
CALENDAR_FUTURE_MONTHS=6

# Where this app is publicly reachable. Instagram fetches a draft's images
# itself from PUBLIC_BASE_URL/media/drafts/... at publish time, so it must be
# a public https URL in production (Instagram cannot fetch http://localhost).
# Telegram-only publishing works fine locally without this.
PUBLIC_BASE_URL=http://localhost:8000

# -- Mocks / local testing --------------------------------------------------
# Host overrides for the three external APIs. Leave at their real defaults
# for production; docker-compose.mocks.yml points these at the local mock
# stack instead (see mocks/ and "Testing against mocks" in readme.md).
INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
INSTAGRAM_API_BASE=https://api.instagram.com
INSTAGRAM_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
TELEGRAM_API_BASE=https://api.telegram.org
# Dev-only: lets an http:// PUBLIC_BASE_URL count as publishable, so
# Instagram-publish can be exercised against the local mock without a
# tunnel. Instagram itself would never accept an http:// image URL — leave
# this false in production.
PUBLISH_ALLOW_HTTP=false
